<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1722">

    <TextView
        android:id="@+id/bannerDemoMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D97706"
        android:text="DEMOTILA AKTIIVINEN – Kokeile leimausta, vuoroja ja ilmoituksia"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F1722">

        <LinearLayout
            android:id="@+id/webViewHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0F1722"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/webOverlayHeader"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="#182332"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnWebOverlayBack"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/nav_btn_inactive"
                    android:text="← Takaisin"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtWebOverlayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/webViewSlot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0F1722" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/nativeStampContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1722"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nativeShiftsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1722"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nativeRequestsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F1722"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#233040" />

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="#0B111A"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnNavStamp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:layout_marginEnd="4dp"
            android:background="@drawable/nav_btn_active"
            android:drawableTop="@drawable/ic_nav_stamp"
            android:drawableTint="#38BDF8"
            android:drawablePadding="2dp"
            android:paddingTop="7dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:gravity="center"
            android:text="Leimaus"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnNavRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:layout_marginEnd="4dp"
            android:background="@drawable/nav_btn_inactive"
            android:drawableTop="@drawable/ic_nav_requests"
            android:drawableTint="#94A3B8"
            android:drawablePadding="2dp"
            android:paddingTop="7dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:gravity="center"
            android:text="Toiveet"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnNavShifts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:layout_marginEnd="4dp"
            android:background="@drawable/nav_btn_inactive"
            android:drawableTop="@drawable/ic_nav_shifts"
            android:drawableTint="#94A3B8"
            android:drawablePadding="2dp"
            android:paddingTop="7dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:gravity="center"
            android:text="Vuorot"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.82"
            android:layout_marginEnd="4dp"
            android:background="@drawable/nav_btn_inactive"
            android:drawableTop="@drawable/ic_nav_settings"
            android:drawableTint="#CBD5E1"
            android:paddingTop="16dp"
            android:paddingBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center"
            android:text=""
            android:contentDescription="Asetukset" />

        <Button
            android:id="@+id/btnNavClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.82"
            android:background="@drawable/nav_btn_close"
            android:drawableTop="@drawable/ic_nav_close"
            android:drawableTint="#FFFFFF"
            android:paddingTop="17dp"
            android:paddingBottom="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center"
            android:text=""
            android:contentDescription="Sulje sovellus" />
    </LinearLayout>
</LinearLayout>
